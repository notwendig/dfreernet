#include <windows.h>
1 RT_MANIFEST "application.manifest"
101 DIALOGEX 0, 0, 290, 105
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Gespeicherten Wert bearbeiten"
FONT 9, "Segoe UI"
BEGIN
 LTEXT "", 100, 10, 10, 270, 36
 EDITTEXT 101, 10, 49, 270, 15, ES_AUTOHSCROLL | WS_TABSTOP
 DEFPUSHBUTTON "OK", IDOK, 168, 79, 52, 16
 PUSHBUTTON "Abbrechen", IDCANCEL, 228, 79, 52, 16
END
1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "FileDescription", "R-net C++ Reconstruction - incomplete development version\0"
   VALUE "ProductName", "R-net Reconstruction\0"
   VALUE "FileVersion", "0.1.0\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
