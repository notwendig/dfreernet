if(NOT DEFINED DECODER OR NOT DEFINED INSTALLATION OR NOT DEFINED OUTPUT)
  message(FATAL_ERROR "Decoder, installation and output required")
endif()
file(REMOVE "${OUTPUT}")
execute_process(COMMAND "${DECODER}" "${INSTALLATION}/RNet Programmer6 OEM.exe" "${INSTALLATION}/Generic_V33_1_1245.rnd" "${OUTPUT}"
  RESULT_VARIABLE result OUTPUT_VARIABLE log ERROR_VARIABLE err)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Decoder failed: ${log} ${err}")
endif()
file(SIZE "${OUTPUT}" length)
file(SHA256 "${OUTPUT}" digest)
if(NOT length EQUAL 4814680 OR NOT digest STREQUAL "30bbe3a7edc45b1ec7975544254bbec6853199a899f46144b33eeebe946723cc")
  message(FATAL_ERROR "Decoded data differ from independently recovered reference: ${length} ${digest}")
endif()
message(STATUS "C++ decoder: all 4,814,680 bytes match independent reference")
